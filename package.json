{
  "name": "@proctorlink/sdk",
  "version": "1.0.0",
  "description": "Browser SDK for ProctorLink remote exam proctoring. Drops into any web assessment (React, Angular, Vue or plain JavaScript) and runs camera keyframe capture, identity checks and proctoring events inside an isolated cross-origin enclave.",
  "keywords": [
    "proctoring",
    "remote-proctoring",
    "online-proctoring",
    "exam-proctoring",
    "exam-integrity",
    "online-exam",
    "assessment",
    "edtech",
    "lms",
    "identity-verification",
    "face-match",
    "webcam",
    "anti-cheating",
    "exam-monitoring",
    "proctorlink"
  ],
  "homepage": "https://proctorlink.com/knowledge/proctoring-for-custom-assessment-platforms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taketwotech/proctorlink-sdk.git"
  },
  "bugs": {
    "url": "https://proctorlink.com/contact",
    "email": "support@proctorlink.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/proctorlink.cjs",
  "module": "./dist/proctorlink.esm.js",
  "browser": "./dist/proctorlink.js",
  "types": "./dist/types/loader/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/loader/index.d.ts",
      "import": "./dist/proctorlink.esm.js",
      "require": "./dist/proctorlink.cjs",
      "default": "./dist/proctorlink.js"
    },
    "./enclave/": "./dist/enclave/",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs && npm run types",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm run types"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
